PORT=8080
WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-value
NODE_ENV=development

# v0.5 target persistence. The hackathon demo remains deterministic/in-memory
# until PostgreSQL is actually provisioned, migrated and wired to repositories.
DATABASE_URL=postgresql://carepath:replace-me@localhost:5432/carepath

# Optional OpenAI configuration for administrator-managed Ayanda fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional deployment metadata for the in-app Release/Verification view.
GIT_COMMIT=local-development
